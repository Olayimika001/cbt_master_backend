## 9. Payment Integration (Paystack)

**Why Paystack over Flutterwave/Stripe:** your users are Nigerian students paying in Naira for small amounts (₦500-class transactions) — Paystack has the strongest local card/bank-transfer/USSD coverage and the most straightforward webhook model for this use case. Stripe doesn't support NGN payouts well; Flutterwave is a reasonable second choice if you ever need multi-country expansion.

**Env vars:** `PAYSTACK_SECRET_KEY`, `PAYSTACK_PUBLIC_KEY` (test keys first, live keys only after going live in the Paystack dashboard).

`src/modules/payments/service.ts`
```typescript
import axios from 'axios';
import crypto from 'crypto';
import { prisma } from '../../config/prisma';
import { env } from '../../config/env';

const paystack = axios.create({
  baseURL: 'https://api.paystack.co',
  headers: { Authorization: `Bearer ${env.PAYSTACK_SECRET_KEY}` },
});

export async function initiatePurchase(userId: string, courseId: string, email: string) {
  const course = await prisma.course.findUniqueOrThrow({ where: { id: courseId } });
  const amountKobo = 50000; // ₦500 — pull from Course pricing field in production

  const { data } = await paystack.post('/transaction/initialize', {
    email,
    amount: amountKobo,
    metadata: { userId, courseId },
  });

  return { checkoutUrl: data.data.authorization_url, reference: data.data.reference };
}

// Called from the webhook route — the ONLY place that grants access.
export async function handlePaystackWebhook(rawBody: Buffer, signature: string) {
  const expectedSig = crypto
    .createHmac('sha512', env.PAYSTACK_SECRET_KEY)
    .update(rawBody)
    .digest('hex');

  if (expectedSig !== signature) {
    throw new Error('Invalid webhook signature');
  }

  const event = JSON.parse(rawBody.toString());
  if (event.event !== 'charge.success') return;

  const { userId, courseId } = event.data.metadata;
  const expiresAt = new Date(Date.now() + 90 * 24 * 60 * 60_000); // 90-day access

  await prisma.subscription.upsert({
    where: { userId_courseId: { userId, courseId } },
    update: { expiresAt, status: 'ACTIVE' },
    create: { userId, courseId, expiresAt, status: 'ACTIVE' },
  });
}
```

The webhook route needs the **raw request body** (not JSON-parsed) to verify the HMAC signature — mount it with `express.raw({ type: 'application/json' })` on that specific route, before your global `express.json()` middleware applies to everything else.

