## 8. The Core Module: Attempts (full reference implementation)

`src/modules/attempts/service.ts`
```typescript
import { prisma } from '../../config/prisma';
import { AttemptStatus } from '@prisma/client';

const ATTEMPT_DURATION_MINUTES = 45;

export async function startAttempt(userId: string, courseId: string) {
  const questions = await prisma.question.findMany({ where: { courseId } });
  if (questions.length === 0) throw new Error('No questions available for this course');

  // Freeze the question set — no correct answers included in the snapshot shown to the client.
  const snapshot = questions.map(q => ({
    id: q.id,
    questionText: q.questionText,
    options: q.options,
  }));

  const expiresAt = new Date(Date.now() + ATTEMPT_DURATION_MINUTES * 60_000);

  const attempt = await prisma.attempt.create({
    data: { userId, courseId, questionSnapshot: snapshot, expiresAt },
  });

  return { attemptId: attempt.id, questions: snapshot, expiresAt };
}

export async function saveAnswer(userId: string, attemptId: string, questionId: string, selectedOptionId: string) {
  const attempt = await prisma.attempt.findFirstOrThrow({ where: { id: attemptId, userId } });

  if (!['IN_PROGRESS', 'PAUSED'].includes(attempt.status)) {
    throw new Error('Attempt is no longer accepting answers');
  }
  if (new Date() > attempt.expiresAt) {
    throw new Error('Attempt has expired');
  }

  // Upsert on the (attemptId, questionId) unique constraint — safe to call repeatedly (autosave).
  await prisma.attemptAnswer.upsert({
    where: { attemptId_questionId: { attemptId, questionId } },
    update: { selectedOptionId, answeredAt: new Date() },
    create: { attemptId, questionId, selectedOptionId },
  });
}

export async function submitAttempt(userId: string, attemptId: string, idempotencyKey: string) {
  // If this exact idempotency key was already used, return the prior result instead of re-grading.
  const existing = await prisma.attempt.findUnique({ where: { idempotencyKey } });
  if (existing && existing.id === attemptId) {
    return { attemptId: existing.id, status: existing.status, score: existing.score };
  }

  const attempt = await prisma.attempt.findFirstOrThrow({ where: { id: attemptId, userId } });

  if (attempt.status === 'GRADED') {
    return { attemptId: attempt.id, status: attempt.status, score: attempt.score };
  }
  if (!['IN_PROGRESS', 'PAUSED'].includes(attempt.status)) {
    throw new Error('Attempt cannot be submitted from its current state');
  }

  const isExpired = new Date() > attempt.expiresAt;

  const [answers, questions] = await Promise.all([
    prisma.attemptAnswer.findMany({ where: { attemptId } }),
    prisma.question.findMany({ where: { courseId: attempt.courseId } }),
  ]);

  const correctMap = new Map(questions.map(q => [q.id, q.correctOptionId]));
  const score = answers.filter(a => correctMap.get(a.questionId) === a.selectedOptionId).length;

  const updated = await prisma.attempt.update({
    where: { id: attemptId },
    data: {
      status: isExpired ? 'EXPIRED' : 'GRADED',
      score,
      submittedAt: new Date(),
      idempotencyKey,
    },
  });

  return { attemptId: updated.id, status: updated.status, score: updated.score };
}
```

This is the piece worth reading line by line — every rule we discussed (server-side timer, idempotent submit, immutable snapshot, upsert-based autosave) is enforced here, not in the controller or the client.

