## 5. Database Schema (Prisma + raw SQL)

```prisma
// prisma/schema.prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id        String   @id @db.Uuid   // matches Supabase auth.users.id
  name      String?
  role      String   @default("student") // "student" | "admin"
  createdAt DateTime @default(now())

  attempts      Attempt[]
  subscriptions Subscription[]
  notifications Notification[]

  @@map("profiles")
}

model Course {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique   // e.g. "GST101"
  title       String
  description String?
  isFree      Boolean  @default(false)
  createdAt   DateTime @default(now())

  questions     Question[]
  attempts      Attempt[]
  subscriptions Subscription[]

  @@map("courses")
}

model Question {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @db.Uuid
  course          Course   @relation(fields: [courseId], references: [id])
  topic           String?
  questionText    String
  options         Json     // [{ id: "a", text: "..." }, ...]
  correctOptionId String
  explanation     String?
  createdAt       DateTime @default(now())

  @@index([courseId])
  @@map("questions")
}

enum AttemptStatus {
  IN_PROGRESS
  PAUSED
  SUBMITTED
  GRADED
  EXPIRED
}

model Attempt {
  id               String        @id @default(uuid()) @db.Uuid
  userId           String        @db.Uuid
  profile          Profile       @relation(fields: [userId], references: [id])
  courseId         String        @db.Uuid
  course           Course        @relation(fields: [courseId], references: [id])
  status           AttemptStatus @default(IN_PROGRESS)
  questionSnapshot Json          // frozen question set at start time, no answers
  score            Int?
  startedAt        DateTime      @default(now())
  expiresAt        DateTime
  submittedAt      DateTime?
  idempotencyKey   String?       @unique // guards duplicate submit calls

  answers AttemptAnswer[]

  @@index([userId])
  @@index([courseId])
  @@map("attempts")
}

model AttemptAnswer {
  id               String   @id @default(uuid()) @db.Uuid
  attemptId        String   @db.Uuid
  attempt          Attempt  @relation(fields: [attemptId], references: [id])
  questionId       String   @db.Uuid
  selectedOptionId String
  answeredAt       DateTime @default(now())

  @@unique([attemptId, questionId]) // one answer per question per attempt — enables upsert
  @@map("attempt_answers")
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
}

model Subscription {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  profile   Profile            @relation(fields: [userId], references: [id])
  courseId  String             @db.Uuid
  course    Course             @relation(fields: [courseId], references: [id])
  startedAt DateTime           @default(now())
  expiresAt DateTime
  status    SubscriptionStatus @default(ACTIVE)

  @@unique([userId, courseId])
  @@map("subscriptions")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  profile   Profile  @relation(fields: [userId], references: [id])
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("notifications")
}
```

Equivalent raw SQL (if you ever need to inspect/run it directly in the Supabase SQL editor) is generated automatically by `npx prisma migrate dev` — don't hand-write parallel SQL, it will drift from the schema.

**RLS policy example** (run in Supabase SQL editor, after `prisma migrate deploy` has created the tables):
```sql
alter table attempts enable row level security;

create policy "Users can read their own attempts"
on attempts for select
using (auth.uid() = "userId");

-- Deliberately no insert/update policy for the anon/authenticated role —
-- all writes to attempts must go through the Express service-role backend.
```

